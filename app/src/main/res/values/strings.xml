    <string name="help_title">How it works</string>
    <string name="help_wifi_title">Wi-Fi scan</string>
    <string name="help_wifi_body">Checks every device on the Wi-Fi you\'re connected to. Devices that answer as cameras, use camera ports or have camera brand names are marked.</string>
    <string name="help_lens_title">Lens finder</string>
    <string name="help_lens_body">Camera lenses reflect light back. In a dark room, with the flash on and the red filter, a lens shows up as a small bright sparkle.</string>
    <string name="help_bt_title">Bluetooth</string>
    <string name="help_bt_body">Lists Bluetooth devices nearby and flags item trackers like AirTag, Tile and SmartTag.</string>
    <string name="help_magnet_title">Magnet meter</string>
    <string name="help_magnet_body">Electronics create a magnetic field. The meter rises when you move the phone close to one.</string>
    <string name="help_limits_title">What no app can do</string>
    <string name="help_limits_body">No phone app can find every camera. A camera that is switched off, not on Wi-Fi, or recording only to an SD card can hide from scans. Always combine the scans with a careful look around the room.</string>

