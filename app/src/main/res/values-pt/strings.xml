    <string name="help_wifi_title">Verificação Wi-Fi</string>
    <string name="help_wifi_body">Verifica cada dispositivo no Wi-Fi em que você está conectado. São marcados os que respondem como câmeras, usam portas de câmera ou têm nomes de marcas de câmera.</string>
    <string name="help_lens_title">Localizador de lentes</string>
    <string name="help_lens_body">Lentes de câmera refletem a luz. Num quarto escuro, com o flash e o filtro vermelho, uma lente aparece como um pequeno brilho.</string>
    <string name="help_bt_title">Bluetooth</string>
    <string name="help_bt_body">Lista dispositivos Bluetooth por perto e marca rastreadores como AirTag, Tile e SmartTag.</string>
    <string name="help_magnet_title">Medidor magnético</string>
    <string name="help_magnet_body">Eletrônicos criam um campo magnético. O medidor sobe quando você aproxima o celular de um deles.</string>
    <string name="help_limits_title">O que nenhum app consegue</string>
    <string name="help_limits_body">Nenhum app de celular encontra todas as câmeras. Uma câmera desligada, fora do Wi-Fi ou que grava só em cartão SD pode escapar das verificações. Sempre combine as verificações com uma inspeção cuidadosa do quarto.</string>
