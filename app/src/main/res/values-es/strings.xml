    <string name="help_title">Cómo funciona</string>
    <string name="help_wifi_title">Escaneo Wi-Fi</string>
    <string name="help_wifi_body">Revisa cada dispositivo del Wi-Fi al que estás conectado. Se marcan los que responden como cámaras, usan puertos de cámara o tienen nombres de marcas de cámaras.</string>
    <string name="help_lens_title">Buscador de lentes</string>
    <string name="help_lens_body">Las lentes de las cámaras reflejan la luz. En una habitación oscura, con el flash y el filtro rojo, una lente aparece como un pequeño destello brillante.</string>
    <string name="help_bt_title">Bluetooth</string>
    <string name="help_bt_body">Muestra los dispositivos Bluetooth cercanos y marca rastreadores como AirTag, Tile y SmartTag.</string>
    <string name="help_magnet_title">Medidor magnético</string>
    <string name="help_magnet_body">Los aparatos electrónicos crean un campo magnético. El medidor sube cuando acercas el teléfono a uno.</string>
    <string name="help_limits_title">Lo que ninguna app puede hacer</string>
    <string name="help_limits_body">Ninguna app puede encontrar todas las cámaras. Una cámara apagada, sin Wi-Fi o que graba solo en una tarjeta SD puede escapar a los escaneos. Combina siempre los escaneos con una revisión cuidadosa de la habitación.</string>
